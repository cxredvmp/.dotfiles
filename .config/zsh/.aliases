#!/bin/bash

# Terminal utilities
alias \
    c="clear" \
    e="exit"

alias \
    cp="cp -irv" \
    mv="mv -iv" \
    r="rm -Iv" \
    rr="rm -Ifrv" \
    md="mkdir -pv"

# Use eza instead of ls if available
if command -v eza > /dev/null; then
    alias \
        ls="eza --group-directories-first" \
        l="ls -a" \
        ll="ls -la"
else
    alias \
        ls="ls --color=auto --group-directories-first -F" \
        l="ls -A" \
        ll="ls -hlA"
fi

alias \
    diff="diff --color=auto" \
    grep="grep --color=auto"

alias \
    ka="killall" \
    ip="ip --color=auto"

alias \
    py="python" \
    vi="nvim"

# Stage and commit with timestamp
alias gct='git commit -am "$(date +"%Y-%m-%d %H:%M:%S")"'
