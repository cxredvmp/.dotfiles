#!/bin/sh

# Check dependencies
if ! command -v socat >/dev/null 2>&1 || ! command -v wl-copy >/dev/null 2>&1; then
    echo "Error: 'socat' and 'wl-clipboard' are missing." >&2
    exit 1
fi

socat TCP4-LISTEN:2224,bind=127.0.0.1,reuseaddr,fork EXEC:wl-copy &
COPY_PID=$!
echo "Listening on 127.0.0.1:2224 for wl-copy"

socat TCP4-LISTEN:2225,bind=127.0.0.1,reuseaddr,fork EXEC:"wl-paste -n" &
PASTE_PID=$!
echo "Listening on 127.0.0.1:2225 for wl-paste"

trap 'kill $COPY_PID $PASTE_PID 2>/dev/null' INT TERM EXIT
wait
